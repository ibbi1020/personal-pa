# Copy this to .env and fill in your values
# Never commit .env to git

OPENROUTER_API_KEY=sk-or-...     # Get from openrouter.ai/keys
OPENROUTER_MODEL=openai/gpt-4o-mini  # Or any OpenRouter model — see openrouter.ai/models
GROQ_API_KEY=gsk_...             # Get from console.groq.com/keys — free, no credit card needed
GOOGLE_CREDENTIALS_PATH=/home/pa/pa/google-credentials.json
GOOGLE_SHEETS_ID=                # Paste the Sheet ID from the URL of your PA Finance spreadsheet
TIMEZONE=Asia/Karachi            # Your timezone — see https://en.wikipedia.org/wiki/List_of_tz_database_time_zones
