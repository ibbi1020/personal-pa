# Copy this to .env and fill in your values
# Never commit .env to git

OPENAI_API_KEY=sk-...
GOOGLE_CREDENTIALS_PATH=/home/pa/pa/google-credentials.json
GOOGLE_SHEETS_ID=                # Paste the Sheet ID from the URL of your PA Finance spreadsheet
TIMEZONE=Asia/Karachi            # Your timezone — see https://en.wikipedia.org/wiki/List_of_tz_database_time_zones
